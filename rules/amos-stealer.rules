alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE AMOS Stealer beacon seen (state only)"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/metrics/run"; startswith; xbits:set,amos.beacon,track ip_src,expire 900; noalert; sid:1000036; rev:2;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE AMOS Stealer registration after beacon (correlated)"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/feed/register"; bsize:18; xbits:isset,amos.beacon,track ip_src; threshold:type limit, track by_src, count 1, seconds 900; classtype:trojan-activity; sid:1000035; rev:2;) 

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MALWARE AMOS Stealer clipper wallet-swap config in HTTP response"; flow:established,to_client; http.stat_code; content:"200"; http.content_type; content:"application/json"; startswith; http.response_body; content:"{|22|rules|22|:[{|22|chain|22|:|22|"; startswith; content:"|22|address|22|:|22|"; distance:0; content:"|22|version|22|:"; distance:0; classtype:trojan-activity; sid:1000038; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"HUNTING AMOS Stealer-style task polling GET /api/tasks/<token>?v=N (curl, IP-literal host)"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/api/tasks/"; startswith; pcre:"/^\/api\/tasks\/[A-Za-z0-9_-]{16,32}\?v=\d+\.\d+$/"; http.user_agent; content:"curl/"; startswith; http.host; pcre:"/^\d{1,3}(?:\.\d{1,3}){3}(?::\d+)?$/"; classtype:trojan-activity; sid:1000048; rev:1;)
