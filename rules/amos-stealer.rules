# AMOS (Atomic macOS) Stealer - post-infection HTTP exfil
# Source: Unit 42 "Atomic macOS (AMOS) Stealer Activity" (2026-09-16)
# Pattern: HTTP POST to C2 with URIs ending in stage=<name>. IPs/domains rotate; the stage= pattern is the durable part.
# SID range 1000030-1000032

# Broad: any POST whose URI ends in a known stage name
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE AMOS Stealer HTTP POST stage parameter";flow:established,to_server; http.method; content:"POST"; http.uri; content:"stage="; fast_pattern;pcre:"/stage=(?:boot|init_session|messengers|credentials|browsers|wallets|resolve_auth|local_data)$/";classtype:trojan-activity; metadata:mitre_tactic TA0010, mitre_technique T1041;sid:1000030; rev:1;)

# Chain: boot/init_session seen first, then a data-bearing stage on the same flow
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE AMOS Stealer session init (stage=init_session)"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"stage=init_session"; endswith; flowbits:set,amos.init; flowbits:noalert; sid:1000031; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any ( msg:"MALWARE AMOS Stealer data exfil after session init (credentials/browsers/wallets)";flow:established,to_server; flowbits:isset,amos.init; http.method; content:"POST"; http.uri; pcre:"/stage=(?:credentials|browsers|wallets|local_data)$/"; classtype:trojan-activity; metadata:mitre_tactic TA0010, mitre_technique T1041; sid:1000032; rev:1;)

alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE AMOS Stealer delivery site SNI getmacouscloud.com"; flow:established,to_server; tls.sni; content:"getmacouscloud.com"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:1000033; rev:1;)

